# Copy this file to .env and fill in the two values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# The anon key is meant to be public — it ships in the browser bundle. Row Level
# Security (see supabase/schema.sql) is what actually protects the data, so never
# put the service_role key in here.
#
# Vite only reads .env at startup: restart `npm run dev` after editing it.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
